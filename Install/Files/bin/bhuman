#!/bin/bash

BASE=/home/booster
BINARY="${BASE}/Config/bhuman"
LOGDIR="${BASE}/logs"
DUMPFILE="${BASE}/bhdump.log"
BACKGROUND=false
DEBUG=false
ROBOTS="${BASE}/Config/Robots/robots.cfg"

usage()
{
  echo "usage: $0 [ -b | -d ] - Starts the last deployed bhuman version."
  echo "    -b  redirect output to logfile only"
  echo "    -d  start bhuman in a debugger"
  exit 1
}

if [ $# -eq 1 ]; then
  case $1 in
    -b)
      BACKGROUND=true
      ;;
    -d)
      DEBUG=true
      ;;
    *)
      usage
      ;;
  esac
elif [ $# -ne 0 ]; then
  usage
fi

if [ -f ${BASE}/touchfiles ]; then
  touch ${BASE}/Config/Robots/*/cameraCalibration.cfg \
    ${BASE}/Config/Robots/*/imuCalibration.cfg 2>/dev/null
  sleep 0.1
  touch ${BASE}/Config/settings.cfg
  rm ${BASE}/touchfiles
fi

# Remove assertion dumps from previous runs.
rm -f "${DUMPFILE}"

# Ignore SIGINT and SIGTERM. This inherits to child processes,
# but bhuman installs its own handlers, so this script will come to an end, too.
trap "" 2 15

# Wait for Motion PC to be available and switch sound output and input.
if [ ! -z "$(grep "\"$(hostname)\"" "${ROBOTS}" | grep -E "robotType *= *t1 *;")" ]; then
  while [ "$(ping -w 1 -c 1 192.168.10.101 >/dev/null && echo 1 || echo 0)" = "0" ]; do
    sleep 1
  done
elif [ "$(systemctl is-active --quiet booster-daemon.service && echo 1 || echo 0)" = "0" ]; then
  while [ "$(systemctl is-active --quiet booster-daemon.service && echo 1 || echo 0)" = "0" ]; do
    sleep 1
  done
  sleep 10
fi

# Select USB sound card as default
while true; do
  USB_AUDIO="$(pactl list sinks short | grep USB | sed -e 's%[^	]*.%%' -e 's%	.*%%')"
  MONO_AUDIO="$(pactl list sources short | grep -E "mono|6ch" | sed -e 's%[^	]*.%%' -e 's%	.*%%')"
  if [ -z "${USB_AUDIO}" -o -z "${MONO_AUDIO}" ]; then
    sleep 1
  else
    pactl set-default-sink "${USB_AUDIO}" >/dev/null 2>&1
    pactl set-default-source "${MONO_AUDIO}" >/dev/null 2>&1
    break
  fi
done

# Set network profile
export FASTRTPS_DEFAULT_PROFILES_FILE=/opt/booster/BoosterRos2/fastdds_profile.xml

# Make log-names unique by numbering them.
COUNTER=$(ls "${LOGDIR}" | sed -nE "s/^bhumand_\(([0-9]+)\).log$/\1/p" | sort -n | tail -n1)
COUNTER=$(expr ${COUNTER} + 1)
LOGFILE="${LOGDIR}/bhumand_(${COUNTER}).log"

# Check whether the binary actually exists
if [ ! -f "${BINARY}" ]; then
  echo "${BINARY} does not exist."
  exit 1
fi

# Disable core dumps
ulimit -c 0

# Actually execute bhuman.
if ${DEBUG}; then
  gdb --args "${BINARY}"
elif ${BACKGROUND}; then
  "${BINARY}" -w 2>&1 | mawk -W interactive -F '\n' '{print strftime("%H:%M:%S", systime()) " " $0}' >"${LOGFILE}"
else
  "${BINARY}" -w 2>&1 | mawk -W interactive -F '\n' '{print strftime("%H:%M:%S", systime()) " " $0}' | tee "${LOGFILE}"
fi
RESULT=${PIPESTATUS[0]}

# Exit with result of ${BINARY}.
exit ${RESULT}

# Helper to setup robot target
# Defines the variables "TARGET_USER", "TARGET_NAME", "TARGET_ARCH", and
# "TARGET_MODEL" based on an IP address.

_BASEPATH=$(cd "$(dirname "$(which "$0")")" && pwd)
_NAME=$(cd "$_BASEPATH/../../Config/Robots"; grep "$1" */network.cfg | sed 's%/.*%%')
_ROBOTTYPE=$(cd "$_BASEPATH/../../Config/Robots"; grep -E "\"$_NAME\"" robots.cfg | sed 's%.*robotType *= *\([^;]*\).*%\1%')
case "$_ROBOTTYPE" in
  k1)
    TARGET_USER=booster
    TARGET_NAME=Booster
    TARGET_ARCH=Arm64
    TARGET_MODEL=K1
    ;;
  t1)
    TARGET_USER=booster
    TARGET_NAME=Booster
    TARGET_ARCH=Arm64
    TARGET_MODEL=T1
    ;;
esac

unset _BASEPATH
unset _NAME
unset _ROBOTTYPE

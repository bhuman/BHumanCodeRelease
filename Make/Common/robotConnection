#!/bin/bash
# Start the version of SimRobot that was compiled most recently and
# remotely connect to a Booster.
# This script can either be launched without arguments, e.g. from
# the Finder, or by passing the ip address of the Booster as its only
# argument. If not ip address is passed, a connection to a K1 robot is
# assumed.

basePath=$(cd "$(dirname "$(which "$0")")"; pwd)
cd "$basePath"

if [ "$(uname)" == "Darwin" ]; then
  app=$(ls -1dt $(find ../../Build/macOS/SimRobot/*/SimRobot.app) | head -1 | sed "s%/SimRobot\.app.*%/SimRobot.app%")
elif [ -e /proc/version ] && [ ! -z "$(grep Microsoft </proc/version)" ]; then
  app=$(ls -1dt ../../Build/Windows/SimRobot/*/SimRobot.exe | head -1)
else
  app=$(ls -1dt ../../Build/Linux/SimRobot/*/SimRobot | head -1)
fi

if [ -n "$1" ]; then
  source "$basePath"/setupTarget "$1"
else
  TARGET_MODEL=K1
fi

scene=$TARGET_MODEL/Remote

if [ ! -z "$app" ]; then
  if [ -n "$1" ]; then
    echo "sc Remote $1" >"../../Config/Scenes/Includes/connect.con"
  fi
  if [ "$(uname)" == "Darwin" ]; then
    open "$app" --args "$basePath/../../Config/Scenes/$scene.ros3"
  elif [ -e /proc/version ] && [ ! -z "$(grep Microsoft </proc/version)" ]; then
    cmd.exe /c start "$app" "../../Config/Scenes/$scene.ros3"
  else
    "$app" "../../Config/Scenes/$scene.ros3" </dev/null >/dev/null 2>&1 &
  fi
fi

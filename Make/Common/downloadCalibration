#!/bin/bash
# Download calibration files from an actual robot.
# The files are then stored in the configuration
# directory for that robot.

basePath=$(cd "$(dirname "$(which "$0")")" && pwd)

usage()
{
  echo "usage: downloadCalibration <ip>"
  echo "  examples:"
  echo "    ./downloadCalibration 192.168.2.28"
  exit 1
}

source "${basePath}/setupSSH"

if [ $# -ne 1 ]
then
  usage
fi

ip=$1

source "$basePath/setupTarget" "$ip"

robotName="$(ssh $SSHOPTIONS -o ConnectTimeout=2 $TARGET_USER@$ip "hostname")"
if [ -z "$robotName" ]
then
  echo "Could not get name from robot."
  exit 1
fi

files=("Config/Robots/$robotName/cameraCalibration.cfg"
       "Config/Robots/$robotName/imuCalibration.cfg")

if [ "$(uname)" == "Darwin" ]; then
  rsync --chmod=F-x -Rzce "ssh $SSHOPTIONS" "$TARGET_USER@$ip:${files[*]}" "$basePath/../.." && ssh $SSHOPTIONS $TARGET_USER@$ip "touch Config/settings.cfg"
else
  rsync --chmod=F-x -Rzce "ssh $SSHOPTIONS" $TARGET_USER@$ip${files[*]//Config/:Config} "$basePath/../.." && ssh $SSHOPTIONS $TARGET_USER@$ip "touch Config/settings.cfg"
fi

<Simulation>

  <Include href="../Includes/T1/T1.rsi3"/>
  <Include href="../Includes/Field2026HSLL.rsi3"/>

  <Scene name="RoboCup" controller="SimulatedRobot" stepLength="0.01" color="rgb(50%, 50%, 50%)">

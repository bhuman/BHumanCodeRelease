<Simulation>

  <Include href="../Includes/K1/K1.rsi3"/>
  <Include href="../Includes/BallFifa3.rsi3"/>
  <Include href="../Includes/Field2026HSLS.rsi3"/>

  <Scene name="RoboCup" controller="SimulatedRobot" stepLength="0.002" color="rgb(65%, 65%, 70%)">
    <PointLight z="9m" intensity="8"/>

    <Compound name="robots">
      <Body ref="K1" name="robot1">
        <Translation x="4" y="-3" z="537mm"/>
        <Rotation z="-90degree"/>
        <Set name="TeamColor" value="blue"/>
      </Body>
      <Body ref="K1" name="robot2">
        <Translation x="3" y="-3" z="537mm"/>
        <Rotation z="-90degree"/>
        <Set name="TeamColor" value="red"/>
      </Body>
      <Body ref="K1" name="robot3">
        <Translation x="2" y="-3" z="537mm"/>
        <Rotation z="-90degree"/>
        <Set name="TeamColor" value="red"/>
      </Body>

      <Body ref="K1" name="robot21">
        <Translation x="-4" y="3" z="537mm"/>
        <Rotation z="90degree"/>
        <Set name="TeamColor" value="purple"/>
      </Body>
      <Body ref="K1" name="robot22">
        <Translation x="-3" y="3" z="537mm"/>
        <Rotation z="90degree"/>
        <Set name="TeamColor" value="white"/>
      </Body>
      <Body ref="K1" name="robot23">
        <Translation x="-2" y="3" z="537mm"/>
        <Rotation z="90degree"/>
        <Set name="TeamColor" value="white"/>
      </Body>
    </Compound>

    <Compound name="teams">
      <Compound name="B-Human">
        <Compound name="5"/>
        <Compound name="red"/>
        <Compound name="blue"/>
      </Compound>
      <Compound name="B-Team">
        <Compound name="70"/>
        <Compound name="white"/>
        <Compound name="purple"/>
      </Compound>
    </Compound>

    <Compound name="extras"/>

    <Compound name="balls">
      <Body ref="ball">
        <Translation z="1m"/>
      </Body>
    </Compound>

    <Compound ref="field"/>

    <Compound name="scenarios">
      <Compound name="CompetitionWalk"/>
    </Compound>

    <Compound name="location">
      <Compound name="SField"/>
    </Compound>

    <Compound ref="robot type"/>
  </Scene>
</Simulation>
